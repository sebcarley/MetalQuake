//============================================================================
// M5 HORDE MODE (m5horde.qc)

.float m5horde;			// set on monsters spawned by the horde director
.float m5h_aggrotime;	// when the director should force-aggro this monster

// M5 BURN (m5_burn): lightning sets things alight
// DarkPlaces entity extensions the burn uses. Both are read by the server in
// sv_send.c and sent to the client, so setting them from here just works.
.vector colormod;		// tints the whole skin (used to char a burning victim)
.vector glowmod;		// tints the model's GLOW layer (embers, once glow skins exist)

.float m5_burnuntil;	// time the fire goes out; 0 = not burning
.float m5_burntick;		// next burn-damage tick
.entity m5_burnfrom;	// who lit it, so the kill is credited correctly

.float m5_zaptime;		// next lightning connect-sizzle; see W_FireLightning

// M5 BALL LIGHTNING (m5_balllightning): the ninth weapon, qc/m5ball.qc.
// IT_M5BALL is stock Quake's spare IT_EXTRA_WEAPON bit (128). The id1 HUD
// draws nothing for bit 7, and the m5 progs never run under the hipnotic
// gamemode (where that bit means Mjolnir), so it is free here. The bit is
// granted alongside IT_LIGHTNING while the cvar is on (M5Ball_Sync) so the
// stock weapon-cycle and W_ChangeWeapon item checks work unchanged.
float	IT_M5BALL				= 128;
// EF_M5BALL is the client's tag for the ball (protocol.h; the former unused
// bit 18): the engine draws the plasma knot at it, gives its light the bolt's
// hue and flicker, weights it in the fog and roots its arcs on it. The arc
// helper carries it with EF_NODRAW (DarkPlaces: sent but not drawn) so the
// second arc follows the ball too.
float	EF_M5BALL				= 262144;
float	EF_NODRAW				= 16;
// DarkPlaces: a named effectinfo block riding the entity as a trail, and the
// two builtins that name and fire such blocks (dpdefs/dpextensions.qc).
.float traileffectnum;
.float alpha;			// DarkPlaces entity alpha (0 = unset = opaque); the ball's fizzle countdown rides it
float(string effectname) particleeffectnum = #335;
void(float effectnum, vector org, vector vel, float howmany) pointparticles = #337;
// DarkPlaces: sin/cos (DP_QC_SINCOSSQRTPOW), for the ball's slow wobble
float(float f) sin = #60;
float(float f) cos = #61;
// DarkPlaces: sound with a pitch (speed, 100 = normal) and flags (DP_SND_SOUND7_WIP2)
void(entity e, float chan, string samp, float vol, float atten, float speed, float flags) sound7 = #8;
.float m5_ballend;		// ball: the moment it discharges (spawn time + life)
.entity m5_arc;			// ball: the helper that owns its second arc (one beam per owning entity)
.float m5_armtime;		// ball: when it will turn on its owner too (m5_balllightning_arm)
.float m5_launchtime;	// ball: when it left the gun (the growth ramp)
.vector m5_heading;		// ball: its course, a unit vector; bent only slightly by nearby prey
.float m5_phase;		// ball: the wobble's phase, random per ball
.float m5_dronepitch;	// ball: the drone's current pitch step (M5Ball_Pressure)
.float m5_zaptick;		// ball: the tick this thing was zapped on (M5Ball_Think marks, the arcs read)
.float m5_zapdist;		// ball: how far it was from the ball that tick
.float m5_zaphit;		// ball: whether the zap actually landed (LightningDamage's word) -- the arc's connect signal
.float m5_arctick;		// ball: the tick an arc was already drawn to it
.float m5_burnforce;	// burn: lit by plasma (the ball) -- the fire burns whatever m5_burn says (m5burn.qc)
// DarkPlaces' punchvector (DP_SV_PUNCHVECTOR): a view-ORIGIN kick, world units,
// sent beside punchangle and decayed by the engine at 20 units a second
// (sv_user.c DropPunchAngle). Stock QuakeC never named it; m5feel.qc's
// weapon kick shoves the eye back along the aim with it.
.vector punchvector;
.float m5_balltint;		// player: the violet cast last stuffed (M5Ball_Pressure), 0 = none

// M5 VENOM (m5_venom): the Scrag's spit carries its own acid light
// PFLAGS_FULLDYNAMIC is DarkPlaces' per-entity real light: arbitrary RGB from
// .color, radius from .light_lev, and -- unlike the older .glow_size path --
// NO corona unless PFLAGS_CORONA is asked for, which matters with the player's
// gl_flashblend/r_coronas configuration. The engine already had all three
// fields; stock QuakeC just never named them, exactly like EF_FLAME above.
// (.light_lev is already declared above, at the light-util fields -- the
// engine reads the same field for the radius, so it needs no second name)
.vector color;			// light colour, 0-1 per channel
.float pflags;			// PFLAGS_* below
float PFLAGS_NOSHADOW	= 1;
float PFLAGS_CORONA		= 2;
float PFLAGS_FULLDYNAMIC = 128;

float m5h_alive;		// living horde monsters this wave
float m5h_lastkill;		// time of the most recent horde monster death

void() M5Horde_WorldSpawn;	// called from worldspawn when m5_horde is on
void() M5Horde_PlayerDied;	// called from PlayerDie when m5_horde is on
void() M5Horde_NextWave;	// impulse 210: cut the between-wave break short
void() M5Horde_Status;		// impulse 211: print wave/alive/budget to the player
